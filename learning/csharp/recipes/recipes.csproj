<!-- recipes/recipes.csproj tells .NET how to build our project -->
<!-- future `dotnet build`s and `dotnet run`s read this file -->

<Project Sdk="Microsoft.NET.Sdk.Web"> <!-- Selects the 'web SDK', the build tools and defaults for an ASP.NET Core web app -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework> <!-- tells .NET to build our app for .NET 10, determines which framework APIs it can use and which runtime it targets -->

    <Nullable>enable</Nullable> <!-- enables compiler warnings about potentially missing null values -->
    
    <!-- i.e. `string` means you intend non-null, `string?` might be null -->

    <ImplicitUsings>enable</ImplicitUsings> <!-- automatically imports common namespaces, i.e. `System` so we don't need to write `using System` in every file -->

    <!-- we still add `using` statements for namespaces outside the default set -->

  </PropertyGroup>

  <ItemGroup>
    <!-- declares a dependency on a NuGet package (a library) -->
    <!-- this one, `OpenApi`, helps generate a machine-readable description of our API -->

    <!-- the URLs, inputs, and responses. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
  </ItemGroup>

</Project>
